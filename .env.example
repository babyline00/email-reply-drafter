# Prisma SQLite database (absolute path recommended for cross-process reliability)
DATABASE_URL=file:/home/z/my-project/apps/38-email-reply-drafter/db/custom.db

# Optional: LLM provider config (consumed by z-ai-web-dev-sdk).
# When unset or PKC_DISABLE_LLM=1, the app falls back to a deterministic MockProvider
# so the UI stays demoable offline.
PKC_DISABLE_LLM=0
